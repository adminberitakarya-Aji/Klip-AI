# Database (required by @klipai/db/client)
# Runtime connection — used by the app (PrismaClient) on every request.
# In Supabase: Settings > Database > Connection string > "Transaction" pooler,
# port 6543, includes ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.ytrmqxacxsmvjasduyao:Balqis28April@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# CLI-only connection — used by `pnpm --filter @klipai/db db:push` / `db:migrate`.
# In Supabase: Settings > Database > Connection string > "Direct connection",
# port 5432, no pgbouncer.
# Locally (no pooler), this can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres.ytrmqxacxsmvjasduyao:Balqis28April@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Auth (NextAuth v5 - must match apps/api)
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Storage - Cloudflare R2 Public URL (for frontend access to generated assets)
# Must match R2_PUBLIC_URL in apps/api/.env
NEXT_PUBLIC_R2_PUBLIC_URL="https://cdn.klip.ai"