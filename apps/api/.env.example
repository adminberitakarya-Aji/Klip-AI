# Database
# Runtime connection — used by the app (PrismaClient) on every request.
# In Supabase: Settings > Database > Connection string > "Transaction" pooler,
# port 6543, includes ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.ytrmqxacxsmvjasduyao:Balqis28April@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# CLI-only connection — used by `pnpm --filter @klipai/db db:push` / `db:migrate`.
# In Supabase: Settings > Database > Connection string > "Direct connection",
# port 5432, no pgbouncer. PgBouncer's transaction mode doesn't reliably
# support the DDL (ALTER TABLE, CREATE INDEX, etc.) these commands run.
# Locally (no pooler), this can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres.ytrmqxacxsmvjasduyao:Balqis28April@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Auth (NextAuth v5)
NEXTAUTH_SECRET="jxnhkDxPDy26qTdt2l5JWA/vuKTMCaH9nmsDv8X+oho="
NEXTAUTH_URL="http://localhost:3001"

# AI Provider
AI_PROVIDER_API_KEY="your-ai-provider-api-key"
AI_PROVIDER_BASE_URL="https://api.your-ai-provider.com"

# AI Provider - Seedance (Primary)
SEEDANCE_API_KEY="your-seedance-api-key"
SEEDANCE_BASE_URL="https://api.seedance.com"

# AI Provider - Kling (Fallback #1)
KLING_API_KEY="your-kling-api-key"
KLING_BASE_URL="https://api.kling.com"

# AI Provider - Wan (Fallback #2)
WAN_API_KEY="your-wan-api-key"
WAN_BASE_URL="https://api.wan.com"

# Storage - Cloudflare R2 (Primary)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="klip-ai-generations"
R2_PUBLIC_URL="https://cdn.klip.ai"  # Optional: Custom domain for public access
R2_REGION="auto"  # Optional: Default is "auto"

# Storage - Vercel Blob (Fallback)
# Get from Vercel Dashboard > Storage > Blob > Settings > Tokens
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"

# FFmpeg - Required for video stitching in template generation
# Docker: Already installed in container at /usr/bin/ffmpeg
# Local development: Install via package manager (brew install ffmpeg, apt install ffmpeg, etc.)
FFMPEG_PATH="/usr/bin/ffmpeg"

# Midtrans Payment Gateway
# Get from https://dashboard.midtrans.com > Settings > Access Keys
# For Sandbox: use Sandbox Server Key (SB-Mid-server-xxx)
# For Production: use Production Server Key (Mid-server-xxx)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false  # Set to "true" for production

# Optional
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SENTRY_DSN=""

# Distributed Rate Limiting - Upstash Redis
# Get from https://console.upstash.com/ > Redis > Create Database
# Leave empty to use in-memory rate limiter (works for single-instance only)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""