# Hoist React types so pnpm resolves a single @types/react across the workspace.
# Without this, the @klipai/ui package (and other workspace packages) get their
# own copy of @types/react, causing TS2786 / ReactNode type-mismatch errors
# with React 19.
public-hoist-pattern[]=*types/react*
public-hoist-pattern[]=*types/react-dom*
public-hoist-pattern[]=*types/three*
auto-install-peers=true
strict-peer-dependencies=false
