{
  "name": "@klipai/ai",
  "version": "0.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./services/*": "./src/services/*.ts",
    "./providers/*": "./src/providers/*.ts",
    "./pipeline/types": "./src/pipeline/types.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
