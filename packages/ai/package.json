    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.2",
    "@klipai/config": "workspace:*",
    "@klipai/core": "workspace:*",
    "@klipai/db": "workspace:*",
    "@sentry/nextjs": "^10.66.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@klipai/tsconfig": "workspace:*",
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
