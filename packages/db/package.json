{
  "name": "@klipai/db",
  "version": "0.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed-templates.ts",
    "db:seed:credits": "tsx prisma/seed-credits.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@klipai/config": "workspace:*"
  },
  "devDependencies": {
    "@klipai/tsconfig": "workspace:*",
    "prisma": "^5.15.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.12.0"
  }
}
