generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  credits       Int       @default(0)  // Saldo credits (0 = perlu top-up)
  hasReceivedFreeCredits Boolean @default(false)  // Apakah sudah dapat free trial
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  generations   Generation[]
  upscalerJobs  UpscalerJob[]
  templateGenerations TemplateGenerationJob[]
  brandKit      BrandKit?
  reviews       TemplateReview[]
  creditTransactions CreditTransaction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Generation {
  id          String           @id @default(cuid())
  userId      String
  prompt      String           @db.Text
  type        GenerationType
  options     Json?
  images      String[]         @default([])
  video       String?
  // NEW: Structured reference images with roles/weights (Phase 11.1)
  referenceImages Json?
  // NEW: Motion brush configuration (Phase 11.2)
  motionBrush Json?
  // NEW: Camera control configuration (Phase 11.2)
  cameraControl Json?
  // NEW: Physics configuration (Phase 11.2)
  physics Json?
  // NEW: Post-processing pipeline (Phase 11.3)
  postProcessing Json?
  status      GenerationStatus @default(QUEUED)
  progress    Int              @default(0)
  resultUrl   String?
  error       String?
  retryCount  Int              @default(0)
  lastFailedAt DateTime?
  creditsUsed Int              @default(1)
  provider    String?
  providerId  String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  upscalerJobs UpscalerJob[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@map("generations")
}

// ============================================
// UPSCALER JOBS (Phase 11.3)
// ============================================

model UpscalerJob {
  id          String   @id @default(cuid())
  userId      String
  // Reference to original generation (optional)
  generationId String?
  // Input video URL
  inputUrl    String
  // Post-processing pipeline config
  pipeline    Json
  // Job status
  status      UpscalerJobStatus @default(QUEUED)
  progress    Int              @default(0)
  // Output video URL
  outputUrl   String?
  error       String?
  // Processing time in milliseconds
  processingTime Int?
  // Input metadata
  inputMetadata Json?
  // Output metadata
  outputMetadata Json?
  // Provider used
  provider    String?
  // Provider job ID
  providerId  String?
  // Webhook URL for callbacks
  webhookUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([generationId])
  @@index([createdAt])
  @@map("upscaler_jobs")
}

enum UpscalerJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum Role {
  USER
  ADMIN
}

enum GenerationType {
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  VIDEO_TO_VIDEO
  TEXT_TO_IMAGE
  IMAGE_TO_IMAGE
  MOTION_CONTROL
  // Phase 11.5: Advanced Generation Modes
  VIDEO_TO_VIDEO_STYLE_TRANSFER
  INPAINTING_OUTPAINTING
  DEPTH_NORMAL_CONTROL
  MULTI_SHOT_STORYBOARD
}

// ============================================
// TEMPLATE SYSTEM (Phase 12.1)
// ============================================

model StoryboardTemplate {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String   @db.Text
  category        String
  tags            String[]
  industry        String?
  format          String
  style           String
  
  // Duration & aspect
  totalDuration   Int
  aspectRatio     String
  shotCount       Int
  
  // Reference style for consistency
  referenceStyleUrl   String?
  referenceStyleType  String?
  
  // Brand kit placeholders
  brandKitSlots     Json?
  
  // Versioning & publishing
  version         Int      @default(1)
  isPublished     Boolean  @default(false)
  isOfficial      Boolean  @default(false)
  authorId        String?
  
  // Preview assets (generated at publish time)
  previewThumbnailUrl String?
  previewVideoUrl     String?
  shotPreviews        Json?
  
  // Credits cost (flat fee per template generation)
  creditsCost     Int      @default(5)
  
  // Stats
  usageCount      Int      @default(0)
  rating          Float?
  reviewCount     Int      @default(0)
  
  // Preset pack relation
  presetPackId    String?
  presetPack      PresetPack? @relation(fields: [presetPackId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  
  shots           TemplateShot[]
  generations     TemplateGenerationJob[]
  reviews         TemplateReview[]
  
  @@index([category])
  @@index([format])
  @@index([isPublished, isOfficial])
  @@index([authorId])
  @@index([presetPackId])
  @@map("storyboard_templates")
}

model TemplateShot {
  id              String   @id @default(cuid())
  templateId      String
  index           Int
  timeRange       String
  duration        Int
  description     String
  prompt          String   @db.Text
  negativePrompt  String?  @db.Text
  camera          String
  lighting        String
  
  // Generation params (full config)
  generationType  String
  resolution      String
  fps             Int
  cameraMotion    String
  motionStrength  Float?
  seed            Int?
  
  // Reference per shot (optional override)
  referenceImageUrl String?
  referenceRole     String?
  referenceWeight   Float?
  
  // Brand kit injection points
  brandKitOverlays  Json?
  
  // Preview (generated at template publish)
  previewUrl        String?
  previewGeneratedAt DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  template          StoryboardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  @@unique([templateId, index])
  @@map("template_shots")
}

// Brand Kit (untuk auto-apply ke template)
model BrandKit {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  logoUrl         String?
  logoPosition    String   @default("bottom-right")
  logoOpacity     Float    @default(0.9)
  colorPalette    String[]
  primaryFont     String?
  secondaryFont   String?
  jingleUrl       String?
  brandGuidelines String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateGenerations TemplateGenerationJob[]
  
  @@map("brand_kits")
}

// Template Generation Job (track batch generation from template)
model TemplateGenerationJob {
  id              String   @id @default(cuid())
  userId          String
  templateId      String
  brandKitId      String?
  status          TemplateJobStatus @default(QUEUED)
  progress        Int      @default(0)
  currentShot     Int      @default(0)
  totalShots      Int
  
  // Input customizations dari user
  customizations  Json?
  
  // Results
  shotResults     Json?
  stitchedVideoUrl String?
  error           String?
  creditsUsed     Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        StoryboardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  brandKit        BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@map("template_generation_jobs")
}

enum TemplateJobStatus {
  QUEUED
  PREPARING
  GENERATING_SHOTS
  STITCHING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

// ============================================
// PRESET PACKS & TEMPLATE REVIEWS (Phase 12.1)
// ============================================

model PresetPack {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  category    String   // "style", "industry", "format"
  thumbnailUrl String?
  isOfficial  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates StoryboardTemplate[]

  @@index([category])
  @@index([isOfficial])
  @@map("preset_packs")
}

model TemplateReview {
  id        String   @id @default(cuid())
  userId    String
  templateId String
  rating    Int      // 1-5
  title     String?
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  StoryboardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
  @@index([userId])
  @@map("template_reviews")
}

enum GenerationStatus {
  IDLE
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// CREDIT SYSTEM (Pay-Per-Use)
// ============================================

// Credit packages yang bisa dibeli user
model CreditPackage {
  id          String   @id @default(cuid())
  name        String   // "Starter Pack", "Pro Pack", "Business"
  slug        String   @unique
  credits     Int      // Jumlah credits yang didapat
  priceIdr    Int      // Harga dalam Rupiah (cents: 50000 = Rp 500)
  priceUsd    Float?   // Harga dalam USD (optional)
  description String?  @db.Text
  features    String[] // Fitur tambahan, misal: ["Priority Support", "No Watermark"]
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)  // Tandai sebagai popular
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions CreditTransaction[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("credit_packages")
}

// Credit transactions (top-up, usage, refund)
model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  packageId   String?  // Null untuk free credits atau usage
  amount      Int      // Jumlah credits (+/-)
  type        CreditTransactionType
  description String?  @db.Text
  
  // Untuk purchase
  orderId     String?  // Midtrans order ID
  paymentStatus PaymentStatus @default(PENDING)
  
  // Metadata tambahan (templateId, generationId, etc)
  metadata    Json?
  
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package     CreditPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transactions")
}

enum CreditTransactionType {
  FREE_CREDITS    // Credits gratis (registration bonus, referral, dll)
  PURCHASE        // Pembelian credits via payment
  USAGE           // Penggunaan credits untuk generation
  REFUND          // Refund credits (generation gagal)
  ADJUSTMENT      // Manual adjustment oleh admin
  EXPIRY          // Credits expired (jika diterapkan)
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}
